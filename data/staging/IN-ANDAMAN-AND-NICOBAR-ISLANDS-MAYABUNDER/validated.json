    {
      "block_type": "paragraph",
      "content": "Veer Savarkar International Airport (IXZ)",
      "source": {
        "source_name": "Incredible India - Mayabunder",
        "source_url": "https://www.incredibleindia.gov.in/en/andaman-and-nicobar-islands/mayabunder",
