    {
      "block_type": "paragraph",
      "content": "Thiruvananthapuram International Airport (TRV)",
      "source": {
        "source_name": "Incredible India - Pathanamthitta",
        "source_url": "https://www.incredibleindia.gov.in/en/kerala/pathanamthitta",
